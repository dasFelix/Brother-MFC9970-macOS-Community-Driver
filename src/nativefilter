#!/bin/sh
#
# Brother MFC-9970CDW macOS Community Driver
# nativefilter
#
# Adds the PJL wrapper required by the printer and applies a targeted
# workaround for CIEBasedABC RGB color spaces generated by macOS cgpdftops.
#
# The MFC-9970CDW renders those calibrated PostScript RGB color spaces
# noticeably too light and with significant hue shifts. The same image data
# renders correctly when interpreted as DeviceRGB.
#

set -eu

OPTIONS="${5:-}"
INPUT="${6:-}"

RENDERMODE="COLOR"
APTMODE="OFF"

case " $OPTIONS " in
    *" ColorModel=Gray "*|*" ColorModel=Mono "*|*" ColorModel=Black "*)
        RENDERMODE="GRAYSCALE"
        ;;
esac

case " $OPTIONS " in
    *" Resolution=600x2400dpi "*)
        APTMODE="ON4"
        ;;
esac


#
# macOS cgpdftops can generate a named CIEBasedABC color space such as:
#
#   [ /CIEBasedABC ... ] /Cs1 exch/ColorSpace dr pop
#   ...
#   /Cs1 SC
#
# The MFC-9970CDW's PostScript interpreter renders RGB images through this
# path with washed-out colors and strong hue shifts.
#
# We only replace named color spaces that have first been positively
# identified as CIEBasedABC resources. Other PostScript color spaces are
# left untouched.
#
color_fix()
{
    LC_ALL=C /usr/bin/awk '
    {
        if ($0 ~ /\/CIEBasedABC/) {
            in_cie = 1
        }

        if (in_cie &&
            $0 ~ /\/Cs[0-9]+[[:space:]]+exch\/ColorSpace[[:space:]]+dr[[:space:]]+pop/) {

            if (match($0, /\/Cs[0-9]+/)) {
                name = substr($0, RSTART, RLENGTH)
                cie_spaces[name] = 1
                in_cie = 0
            }
        }

        for (name in cie_spaces) {
            pattern = name "[[:space:]]+SC"

            if ($0 ~ pattern) {
                gsub(pattern, "/DeviceRGB setcolorspace")
            }
        }

        print
    }
    '
}


# Universal Exit Language + Brother PJL setup.
printf '\033%%-12345X'
printf '@PJL SET RENDERMODE=%s\r\n' "$RENDERMODE"
printf '@PJL SET RESOLUTION=600\r\n'
printf '@PJL SET APTMODE=%s\r\n' "$APTMODE"
printf '@PJL ENTER LANGUAGE=POSTSCRIPT\r\n'


#
# Preserve ordinary PostScript byte-for-byte whenever possible.
# Only invoke the color workaround when CIEBasedABC is actually present.
#
if [ -n "$INPUT" ] && [ -f "$INPUT" ]; then
    if LC_ALL=C /usr/bin/grep -aq '/CIEBasedABC' "$INPUT"; then
        echo "INFO: Applying MFC-9970CDW CIEBasedABC color workaround." >&2
        color_fix < "$INPUT"
    else
        /bin/cat "$INPUT"
    fi
else
    # CUPS may also provide the job on stdin. In that case the filter must
    # inspect the stream while passing it through.
    color_fix
fi


# End the PostScript/PJL job.
printf '\r\n\033%%-12345X'

exit 0
